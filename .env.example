VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Cloudflare Turnstile site key for public inquiry forms.
# Pair the staging site key with TURNSTILE_SECRET_KEY in staging Edge Function secrets.
VITE_TURNSTILE_SITE_KEY=

# Private development feature. Leave false in the client production environment
# until the migration, content, workflow, and QA are complete.
VITE_ENABLE_INFORMATION_CENTRE=false

# Edge functions only. Never expose this in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend inbound-email webhook signing secret (whsec_...). Required in all
# environments; the signature bypass in receive-inbound-email is active only
# when ENVIRONMENT=development.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret

# Runtime environment label for edge functions (development | staging | production).
ENVIRONMENT=development

# Cloudflare Turnstile server-side verification secret; configure separately per environment.
TURNSTILE_SECRET_KEY=

# Set true only after staging verifies trusted client-IP ingress and email quotas.
PUBLIC_INQUIRY_CONFIRMATIONS_ENABLED=false
# Keep true for local development unless outbound test emails are explicitly required.
SUPPRESS_OUTBOUND_EMAILS=true
