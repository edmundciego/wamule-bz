.DS_Store

# Local environment and credentials
.env
.env.*
!.env.example
.herenow/

# Dependencies and generated output
node_modules/
dist/
graphify-out/
out/
e2e/fixtures/hopkins/
# Tenant packages: scaffolding is committed; working areas never are.
tenants/*/source/
tenants/*/build/

# Supabase local state
supabase/.temp/

# Standalone docusaurus docs site (was a broken submodule link with no
# .gitmodules URL, which breaks Netlify clones; deployed separately to
# docs.wamuledevelopment.com). Trailing space in dirname is escaped.
documentation\ /

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
