{
  "name": "wamule-development",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "vite --config apps/map-studio/vite.config.ts",
    "studio:build": "tsc -p apps/map-studio/tsconfig.json && vite build --config apps/map-studio/vite.config.ts",
    "studio:extract": "python3 scripts/map-studio/extract.py",
    "studio:test": "python3 -m unittest discover -s test/map-studio -p 'test_*.py'",
    "studio:verify-db": "node scripts/map-studio/db-rehearsal.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "node scripts/build-staging.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:homepage": "playwright test --config e2e/shared-public-homepage.config.ts",
    "test:e2e:smoke": "playwright install chromium && playwright test --project=chromium --project=mobile",
    "check:brand": "node scripts/check-brand.mjs",
    "map:build": "node scripts/build-interactive-map.mjs",
    "tenant:init": "node scripts/tenant-init.mjs",
    "tenant:onboard": "node scripts/tenant-onboard.mjs",
    "db:verify-hosted-pilot": "python3 scripts/hosted-pilot-db-harness.py",
    "db:rehearse-hopkins-snapshot": "python3 scripts/hosted-pilot-db-harness.py --actual-hopkins",
    "package:hopkins-owner-pilot": "node scripts/package-hopkins-owner-pilot.mjs",
    "package:verify-hopkins-owner-pilot": "node scripts/verify-hopkins-owner-pilot-package.mjs",
    "map:import-hopkins-production": "node scripts/import-hopkins-production-snapshot.mjs",
    "tenant:onboard-hopkins-production": "node scripts/tenant-onboard-production.mjs",
    "migration:prepare-hopkins-production-phase": "node scripts/prepare-hopkins-production-migration-phase.mjs",
    "map:import-hopkins-demo": "node scripts/import-hopkins-demo-features.mjs",
    "tenant:build": "node scripts/tenant-build.mjs",
    "tenant:verify": "node scripts/verify-tenant-build.mjs",
    "probe:production-map": "node scripts/probe-production-map.mjs",
    "verify:public-build": "node scripts/verify-public-build.mjs",
    "verify:public-build:staging": "node scripts/verify-public-build.mjs --staging",
    "tenant:publish": "node scripts/tenant-publish.mjs",
    "map:publish": "node scripts/publish-lots.mjs",
    "map:audit": "node scripts/audit-plot-counts.mjs",
    "typecheck": "tsc -b",
    "verify": "npm run check:brand && npm run typecheck && npm run lint && npm test && npm run test:e2e:smoke && npm run build && npm run verify:public-build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.2.5"
  }
}
